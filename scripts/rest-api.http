@nacosConsoleUrl = http://localhost:18080/
@userBaseUrl = http://localhost:8081
@dishBaseUrl = http://localhost:8082
@orderBaseUrl = http://localhost:8083
@smokeUserId = student-1
@smokeMerchantId = 10
@smokeDishId = 1

### 01 测试 Nacos 控制台可访问，并初始化本次测试
< {%
    [
        "smoke_userActive", "smoke_beforeDish", "smoke_beforeOrders",
        "smoke_created", "smoke_orderNo", "smoke_detail",
        "smoke_afterOrders", "smoke_afterDishes",
        "smoke_missingUserRejected", "smoke_disabledUserRejected", "smoke_missingDishRejected"
    ].forEach(name => client.global.clear(name));
%}
GET {{nacosConsoleUrl}}

> {%
    client.test("Nacos 控制台返回 200", () => {
        client.assert(response.status === 200);
    });
%}

### 02 用户服务健康检查
GET {{userBaseUrl}}/actuator/health
Accept: application/json

> {%
    client.test("用户服务健康状态为 UP", () => {
        client.assert(response.status === 200);
    });
%}

