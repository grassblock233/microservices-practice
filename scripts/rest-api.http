### 16 异常下单后订单列表应完全不变
GET {{orderBaseUrl}}/api/orders?userId={{smokeUserId}}
Accept: application/json

> {%
    client.test("异常请求未产生订单或改变已有订单", () => {
        client.assert(response.status === 200);
        client.assert(["smoke_missingUserRejected", "smoke_disabledUserRejected", "smoke_missingDishRejected"]
            .every(name => client.global.get(name) === "true"), "请先确认三个异常下单场景全部通过");
        client.assert(JSON.stringify(response.body) === client.global.get("smoke_afterOrders"), "异常请求改变了订单列表");
    });
%}

### 17 异常下单后菜品列表应完全不变
GET {{dishBaseUrl}}/api/dishes?merchantId={{smokeMerchantId}}
Accept: application/json

> {%
    client.test("异常请求未改变菜品和库存", () => {
        client.assert(response.status === 200, "预期 200，实际 " + response.status);
        client.assert(JSON.stringify(response.body) === client.global.get("smoke_afterDishes"), "异常请求改变了菜品或库存");
        client.log("PASS rejected requests left inventory unchanged; orderNo=" + client.global.get("smoke_orderNo"));
    });
%}
